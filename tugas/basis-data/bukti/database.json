      "sql": "SELECT waktu_diterima, protokol, seq, suhu, kelembapan\nFROM readings\nWHERE device_id = 'demo-node-01'\n  AND waktu_diterima >= strftime('%Y-%m-%dT%H:%M:%f+00:00', 'now', '-1 hour')\nORDER BY waktu_diterima DESC\nLIMIT 10;",
